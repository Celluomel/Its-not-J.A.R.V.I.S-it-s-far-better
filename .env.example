# Lumina — environment variable secrets
# Copy this to .env and fill in your values
# NEVER commit .env to git

# LLM providers (leave blank if not used)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search providers
BRAVE_SEARCH_KEY=
SERPAPI_KEY=

# Voice
ELEVENLABS_API_KEY=

# Messaging connectors
TELEGRAM_TOKEN=
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_TOKEN=

# Security — generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
LUMINA_SESSION_SECRET=
